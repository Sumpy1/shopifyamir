{%- liquid
  assign show_category = show_category | default: false
  assign image = product.featured_image | default: product.images.first
  assign hover_image = product.images[1] | default: image
-%}

<div class="product-card" data-product-card>
  <a href="{{ product.url }}" class="product-card__link">
    <div class="product-card__image-wrapper">
      {%- if image != blank -%}
        <img 
          src="{{ image | image_url: width: 600 }}" 
          alt="{{ image.alt | escape }}"
          class="product-card__image product-card__image--primary"
          loading="lazy"
          width="600"
          height="600"
        >
        {%- if hover_image != blank and hover_image != image -%}
          <img 
            src="{{ hover_image | image_url: width: 600 }}" 
            alt="{{ hover_image.alt | escape }}"
            class="product-card__image product-card__image--hover"
            loading="lazy"
            width="600"
            height="600"
          >
        {%- endif -%}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'product-card__placeholder' }}
      {%- endif -%}
    </div>
    <div class="product-card__info">
      {%- if show_category -%}
        {%- assign product_type = product.type | default: 'Product' -%}
        <p class="product-card__category">{{ product_type }}</p>
      {%- endif -%}
      <h3 class="product-card__name">{{ product.title }}</h3>
      <p class="product-card__price">
        {{ product.price | money }}
        {%- if product.compare_at_price > product.price -%}
          <span class="product-card__price-compare">{{ product.compare_at_price | money }}</span>
        {%- endif -%}
      </p>
    </div>
  </a>
</div>

