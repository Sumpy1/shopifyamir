{%- liquid
  assign menu = section.settings.menu
  assign logo = section.settings.logo
-%}

<header class="header" data-header>
  <div class="header__inner">
    <nav class="header__nav" aria-label="Primary">
      <ul class="header__nav-list">
        {%- for link in linklists[menu].links -%}
          <li class="header__nav-item">
            {%- if link.links != blank -%}
              <div class="header__nav-dropdown">
                <a href="{{ link.url }}" class="header__nav-link">{{ link.title }}</a>
                <div class="header__mega-menu">
                  <div class="header__mega-menu-inner">
                    {%- for childlink in link.links -%}
                      <div class="header__mega-menu-column">
                        <a href="{{ childlink.url }}" class="header__mega-menu-title">{{ childlink.title }}</a>
                        {%- if childlink.links != blank -%}
                          <ul class="header__mega-menu-list">
                            {%- for grandchildlink in childlink.links -%}
                              <li>
                                <a href="{{ grandchildlink.url }}" class="header__mega-menu-link">{{ grandchildlink.title }}</a>
                              </li>
                            {%- endfor -%}
                          </ul>
                        {%- endif -%}
                      </div>
                    {%- endfor -%}
                  </div>
                </div>
              </div>
            {%- else -%}
              <a href="{{ link.url }}" class="header__nav-link">{{ link.title }}</a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    <div class="header__logo">
      <a href="{{ routes.root_url }}" class="header__logo-link">
        {%- if logo != blank -%}
          <img src="{{ logo | image_url: width: 200 }}" alt="{{ shop.name }}" width="200" height="auto">
        {%- else -%}
          <span class="header__logo-text">KombuchaMarket</span>
        {%- endif -%}
      </a>
    </div>

    <div class="header__actions">
      <div class="header__search-wrapper" data-search-wrapper>
        <button type="button" class="header__action-btn header__search-toggle" aria-label="Search" data-search-toggle>
          {% render 'icon-search' %}
        </button>
        <form class="header__search-form" action="{{ routes.search_url }}" method="get" data-search-form>
          <input 
            type="search" 
            name="q" 
            class="header__search-input" 
            placeholder="Search products..." 
            autocomplete="off"
            aria-label="Search"
            data-search-input
          >
          <button type="submit" class="header__action-btn header__search-submit" aria-label="Submit search">
            {% render 'icon-search' %}
          </button>
        </form>
        <div class="header__predictive-search" data-predictive-search></div>
      </div>
      <div class="header__account-wrapper" data-account-wrapper>
        <button type="button" class="header__action-btn header__account-btn" aria-label="Account" data-account-toggle>
          {% render 'icon-profile' %}
        </button>
        <div class="header__account-dropdown" data-account-dropdown>
          {%- if customer -%}
            <!-- Logged in state -->
            <div class="header__account-dropdown-content">
              <div class="header__account-welcome">
                <p class="header__account-greeting">Welcome back,</p>
                <p class="header__account-name">{{ customer.first_name | default: customer.email }}</p>
              </div>
              <div class="header__account-links">
                <a href="{{ routes.account_url }}" class="header__account-link">
                  <svg class="header__account-link-icon" width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M3.333 5h13.334M3.333 10h13.334M3.333 15h13.334" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                  </svg>
                  <span>Orders</span>
                </a>
                <a href="{{ routes.account_url }}" class="header__account-link">
                  <svg class="header__account-link-icon" width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M10 10c2.5 0 4.583-2.083 4.583-4.583S12.5 0.833 10 0.833 5.417 2.917 5.417 5.417 7.5 10 10 10z" stroke="currentColor" stroke-width="1.5" fill="none"/>
                    <path d="M17.5 19.167c0-4.167-3.333-7.5-7.5-7.5s-7.5 3.333-7.5 7.5" stroke="currentColor" stroke-width="1.5" fill="none"/>
                  </svg>
                  <span>Profile</span>
                </a>
                <a href="{{ routes.account_logout_url }}" class="header__account-link header__account-link--logout">
                  <span>Sign Out</span>
                </a>
              </div>
            </div>
          {%- else -%}
            <!-- Not logged in state -->
            <div class="header__account-dropdown-content">
              <h3 class="header__account-title">Account</h3>
              <div class="header__account-signin">
                <a href="{{ routes.account_login_url }}" class="header__account-signin-btn header__account-signin-btn--primary">
                  <span>Sign in with shop</span>
                </a>
                <a href="{{ routes.account_login_url }}" class="header__account-signin-btn header__account-signin-btn--secondary">
                  <span>Other sign in options</span>
                </a>
              </div>
              <div class="header__account-links">
                <a href="{{ routes.account_login_url }}" class="header__account-link">
                  <svg class="header__account-link-icon" width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M3.333 5h13.334M3.333 10h13.334M3.333 15h13.334" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                  </svg>
                  <span>Orders</span>
                </a>
                <a href="{{ routes.account_login_url }}" class="header__account-link">
                  <svg class="header__account-link-icon" width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M10 10c2.5 0 4.583-2.083 4.583-4.583S12.5 0.833 10 0.833 5.417 2.917 5.417 5.417 7.5 10 10 10z" stroke="currentColor" stroke-width="1.5" fill="none"/>
                    <path d="M17.5 19.167c0-4.167-3.333-7.5-7.5-7.5s-7.5 3.333-7.5 7.5" stroke="currentColor" stroke-width="1.5" fill="none"/>
                  </svg>
                  <span>Profile</span>
                </a>
              </div>
            </div>
          {%- endif -%}
        </div>
      </div>
      <button type="button" class="header__action-btn header__cart-btn" aria-label="Cart" data-cart-toggle>
        {% render 'icon-cart' %}
        <span class="header__cart-count" data-cart-count>{{ cart.item_count }}</span>
      </button>
      <button type="button" class="header__mobile-menu-btn" aria-label="Menu" data-mobile-menu-toggle>
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>

  <div class="header__mobile-menu" data-mobile-menu>
    <div class="header__mobile-menu-inner">
      <nav class="header__mobile-nav">
        <ul class="header__mobile-nav-list">
          {%- for link in linklists[menu].links -%}
            <li class="header__mobile-nav-item">
              <a href="{{ link.url }}" class="header__mobile-nav-link">{{ link.title }}</a>
              {%- if link.links != blank -%}
                <ul class="header__mobile-nav-sublist">
                  {%- for childlink in link.links -%}
                    <li>
                      <a href="{{ childlink.url }}" class="header__mobile-nav-sublink">{{ childlink.title }}</a>
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </nav>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "image_picker",
      "id": "favicon",
      "label": "Favicon",
      "info": "Upload a favicon image (recommended size: 32x32px or 16x16px). This will appear in the browser tab."
    }
  ]
}
{% endschema %}

