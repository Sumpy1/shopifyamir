<div class="faq-page">
  <div class="faq-page__inner">
    <!-- Page Header -->
    <div class="faq-page__header">
      <span class="faq-page__label">{{ section.settings.label | default: 'Help Center' }}</span>
      <h1 class="faq-page__title">{{ section.settings.title | default: 'Frequently Asked Questions' }}</h1>
      <p class="faq-page__description">
        {{ section.settings.description | default: 'Find answers to common questions about our products, shipping, returns, and more.' }}
      </p>
    </div>

    <!-- FAQ Sections -->
    <div class="faq-page__sections">
      {%- for block in section.blocks -%}
        {%- if block.type == 'category' -%}
          <section class="faq-category" {{ block.shopify_attributes }}>
            <h2 class="faq-category__title">{{ block.settings.category_title }}</h2>
            <div class="faq-accordion">
              {%- for i in (1..10) -%}
                {%- assign question_key = 'question_' | append: i -%}
                {%- assign answer_key = 'answer_' | append: i -%}
                {%- assign question = block.settings[question_key] -%}
                {%- assign answer = block.settings[answer_key] -%}
                {%- if question != blank and answer != blank -%}
                  <div class="faq-item">
                    <button class="faq-item__trigger" type="button" aria-expanded="false" data-faq-trigger>
                      <span>{{ question }}</span>
                      <svg class="faq-item__icon" width="20" height="20" viewBox="0 0 20 20" fill="none">
                        <path d="M5 7.5l5 5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </button>
                    <div class="faq-item__content" data-faq-content>
                      <p>{{ answer }}</p>
                    </div>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </section>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <!-- Contact Section -->
    <div class="faq-page__contact">
      <h2 class="faq-page__contact-title">{{ section.settings.contact_title | default: 'Still have questions?' }}</h2>
      <p class="faq-page__contact-description">
        {{ section.settings.contact_description | default: "Can't find what you're looking for? We're here to help!" }}
      </p>
      <div class="faq-page__contact-links">
        <a href="mailto:{{ section.settings.contact_email | default: 'hello@kombuchamarket.com' }}" class="faq-page__contact-link">
          {{ section.settings.contact_email | default: 'hello@kombuchamarket.com' }}
        </a>
        <span class="faq-page__contact-separator">•</span>
        <a href="tel:{{ section.settings.contact_phone | default: '6155550123' }}" class="faq-page__contact-link">
          {{ section.settings.contact_phone | default: '(615) 555-0123' }}
        </a>
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const triggers = document.querySelectorAll('[data-faq-trigger]');
  
  triggers.forEach(trigger => {
    trigger.addEventListener('click', function() {
      const content = this.nextElementSibling;
      const isExpanded = this.getAttribute('aria-expanded') === 'true';
      
      // Close all other items
      triggers.forEach(t => {
        if (t !== this) {
          t.setAttribute('aria-expanded', 'false');
          t.nextElementSibling.style.maxHeight = null;
          t.classList.remove('is-active');
        }
      });
      
      // Toggle current item
      if (isExpanded) {
        this.setAttribute('aria-expanded', 'false');
        content.style.maxHeight = null;
        this.classList.remove('is-active');
      } else {
        this.setAttribute('aria-expanded', 'true');
        content.style.maxHeight = content.scrollHeight + 'px';
        this.classList.add('is-active');
      }
    });
  });
});
</script>

