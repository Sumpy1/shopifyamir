<div class="brands-page">
  <div class="brands-page__inner">
    <!-- Page Header -->
    <div class="brands-page__header">
      <span class="brands-page__label">Featured Brands</span>
      <h1 class="brands-page__title">{{ page.title | default: 'Featured Kombucha Brands' }}</h1>
      {%- if page.content != blank -%}
        <div class="brands-page__description">{{ page.content }}</div>
      {%- else -%}
        <p class="brands-page__description">
          We feature America's most distinguished kombucha artisans to bring you 
          the finest selection of craft fermented beverages. Each brand brings unique flavors 
          and brewing techniques to our curated collection.
        </p>
      {%- endif -%}
    </div>

    <!-- Brands Grid -->
    <div class="brands-page__grid">
      {%- for block in section.blocks -%}
        {%- assign brand = block.settings -%}
        <a href="{{ brand.collection_url | default: '/collections/all' }}" class="brands-page__card" {{ block.shopify_attributes }}>
          <article class="brand-card">
            <div class="brand-card__image-wrapper">
              {%- if brand.image != blank -%}
                <img
                  src="{{ brand.image | image_url: width: 600 }}"
                  alt="{{ brand.name }}"
                  class="brand-card__image"
                  width="600"
                  height="600"
                  loading="lazy"
                >
              {%- else -%}
                <div class="brand-card__placeholder">
                  {{ brand.name | first }}
                </div>
              {%- endif -%}
            </div>
            <div class="brand-card__content">
              {%- if brand.tagline != blank -%}
                <span class="brand-card__tagline">{{ brand.tagline }}</span>
              {%- endif -%}
              <h3 class="brand-card__name">{{ brand.name }}</h3>
              {%- if brand.description != blank -%}
                <p class="brand-card__description">{{ brand.description }}</p>
              {%- endif -%}
              <div class="brand-card__link">
                <span>Shop Collection</span>
                <svg class="brand-card__arrow" width="16" height="16" viewBox="0 0 16 16" fill="none">
                  <path d="M6 12l4-4-4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
            </div>
          </article>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

