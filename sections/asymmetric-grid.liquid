{%- liquid
  assign image_1 = section.settings.image_1
  assign image_2 = section.settings.image_2
  assign link_1 = section.settings.link_1
  assign link_2 = section.settings.link_2
-%}

<section class="asymmetric-grid" data-section>
  <div class="asymmetric-grid__inner">
    <div class="asymmetric-grid__item asymmetric-grid__item--small">
      {%- if link_1 != blank -%}
        <a href="{{ link_1 }}" class="asymmetric-grid__link">
      {%- endif -%}
        <div class="asymmetric-grid__image-wrapper">
          {%- if image_1 != blank -%}
            <img 
              src="{{ image_1 | image_url: width: 800 }}" 
              alt="{{ image_1.alt | escape }}"
              class="asymmetric-grid__image"
              loading="lazy"
              width="800"
              height="1200"
            >
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'asymmetric-grid__placeholder' }}
          {%- endif -%}
        </div>
      {%- if link_1 != blank -%}
        </a>
      {%- endif -%}
    </div>

    <div class="asymmetric-grid__item asymmetric-grid__item--large">
      <div class="asymmetric-grid__image-wrapper">
        {%- if image_2 != blank -%}
          <img 
            src="{{ image_2 | image_url: width: 1600 }}" 
            alt="{{ image_2.alt | escape }}"
            class="asymmetric-grid__image"
            loading="lazy"
            width="1600"
            height="1200"
          >
        {%- else -%}
          {{ 'image' | placeholder_svg_tag: 'asymmetric-grid__placeholder' }}
        {%- endif -%}
        {%- if section.settings.overlay_text_2 != blank or section.settings.overlay_button_text_2 != blank -%}
          <div class="asymmetric-grid__overlay">
            <div class="asymmetric-grid__overlay-content">
              {%- if section.settings.overlay_text_2 != blank -%}
                <p class="asymmetric-grid__overlay-text">{{ section.settings.overlay_text_2 }}</p>
              {%- endif -%}
              {%- if section.settings.overlay_button_text_2 != blank -%}
                <a href="{{ section.settings.overlay_button_link_2 | default: '/pages/contact' }}" class="asymmetric-grid__overlay-button">
                  {{ section.settings.overlay_button_text_2 }}
                </a>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      </div>
      {%- if link_2 != blank and section.settings.overlay_text_2 == blank and section.settings.overlay_button_text_2 == blank -%}
        <a href="{{ link_2 }}" class="asymmetric-grid__link">
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Asymmetric Grid",
  "settings": [
    {
      "type": "header",
      "content": "Small Image (1/3)"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image"
    },
    {
      "type": "url",
      "id": "link_1",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Large Image (2/3)"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image"
    },
    {
      "type": "url",
      "id": "link_2",
      "label": "Link",
      "info": "Only used if overlay is not enabled"
    },
    {
      "type": "header",
      "content": "Overlay Content"
    },
    {
      "type": "textarea",
      "id": "overlay_text_2",
      "label": "Overlay Text",
      "default": "Want to sell your Kombucha on Kombucha Market?"
    },
    {
      "type": "text",
      "id": "overlay_button_text_2",
      "label": "Button Text",
      "default": "Contact us"
    },
    {
      "type": "url",
      "id": "overlay_button_link_2",
      "label": "Button Link",
      "info": "Leave empty to use default contact page"
    }
  ],
  "presets": [
    {
      "name": "Asymmetric Grid"
    }
  ]
}
{% endschema %}

