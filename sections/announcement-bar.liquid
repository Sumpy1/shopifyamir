{%- liquid
  assign message = section.settings.message
  assign link = section.settings.link
  assign text_color = section.settings.text_color
  assign background_color = section.settings.background_color
  assign show_on_homepage_only = section.settings.show_on_homepage_only
-%}

{%- if show_on_homepage_only == false or template.name == 'index' -%}
  {%- if message != blank -%}
    <div class="announcement-bar" style="background-color: {{ background_color }}; color: {{ text_color }};" data-announcement-bar>
      <div class="announcement-bar__inner">
        <div class="announcement-bar__content">
          {%- if link != blank -%}
            <a href="{{ link }}" class="announcement-bar__link">
              <span class="announcement-bar__text">{{ message }}</span>
            </a>
          {%- else -%}
            <span class="announcement-bar__text">{{ message }}</span>
          {%- endif -%}
        </div>
        {%- if section.settings.show_close_button -%}
          <button 
            type="button" 
            class="announcement-bar__close" 
            aria-label="Close announcement"
            data-announcement-close
          >
            {% render 'icon-close' %}
          </button>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    {
      "type": "text",
      "id": "message",
      "label": "Message",
      "default": "Free shipping on orders over $50"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "checkbox",
      "id": "show_close_button",
      "label": "Show close button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_on_homepage_only",
      "label": "Show on homepage only",
      "default": false
    }
  ]
}
{% endschema %}
