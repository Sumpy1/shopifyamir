<footer class="footer">
  <div class="footer__inner">
    <div class="footer__content">
      <div class="footer__column">
        <h3 class="footer__title">Shop</h3>
        <ul class="footer__links">
          <li><a href="/pages/brands">Brands</a></li>
          <li><a href="/collections/kombucha">Kombucha</a></li>
          <li><a href="/collections/prebiotic">Prebiotic</a></li>
          <li><a href="/collections/bundles">Bundles</a></li>
        </ul>
      </div>
      <div class="footer__column">
        <h3 class="footer__title">About</h3>
        <ul class="footer__links">
          <li><a href="/pages/about">Our Story</a></li>
          <li><a href="/pages/faq">FAQ</a></li>
          <li><a href="/pages/wellness">Wellness</a></li>
        </ul>
      </div>
      <div class="footer__column">
        <h3 class="footer__title">Connect</h3>
        <ul class="footer__links">
          <li><a href="/pages/contact">Contact</a></li>
          <li><a href="/pages/newsletter">Newsletter</a></li>
          <li><a href="/pages/shipping-returns">Shipping & Returns</a></li>
        </ul>
      </div>
      <div class="footer__column footer__newsletter">
        <h3 class="footer__title">Newsletter</h3>
        <p class="footer__newsletter-text">Stay updated with Nashville's best kombucha finds</p>
        {% form 'customer', class: 'footer__newsletter-form', id: 'newsletter-form' %}
          {%- if form.posted_successfully? -%}
            <p class="footer__newsletter-success">Thanks for subscribing!</p>
          {%- else -%}
            <input 
              type="email" 
              name="contact[email]" 
              class="footer__newsletter-input" 
              placeholder="Enter your email" 
              required 
              aria-label="Email address"
            >
            <input type="hidden" name="contact[tags]" value="newsletter">
            <button type="submit" class="footer__newsletter-button">Subscribe</button>
          {%- endif -%}
        {% endform %}
      </div>
    </div>
    <div class="footer__bottom">
      <p class="footer__disclaimer">KombuchaMarket is a Nashville-based marketplace featuring kombucha products. We are not an official retailer or partner of the brands featured.</p>
      <p class="footer__copyright">&copy; {{ 'now' | date: '%Y' }} KombuchaMarket. All rights reserved.</p>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": []
}
{% endschema %}

